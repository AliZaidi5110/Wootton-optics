# Site
NEXT_PUBLIC_SITE_URL=https://www.woottonhearing.co.uk
NEXT_PUBLIC_SITE_NAME=Wootton Hearing & Optics

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wootton

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
EMAIL_FROM=bookings@woottonhearing.co.uk

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Calendly / Booking
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/wootton-hearing

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Stripe (optional e-commerce)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Contentful CMS (optional)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
