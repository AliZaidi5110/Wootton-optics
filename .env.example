# Site
NEXT_PUBLIC_SITE_URL=https://www.woottonopticianshearingcare.co.uk
NEXT_PUBLIC_SITE_NAME=Wootton Optician & Hearing Care

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wootton

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Practice email (only address used sitewide for contact / Resend)
# Admin@woottonopticianshearingcare.co.uk

# Resend (contact form) — get your API key at https://resend.com/api-keys
# Verify domain woottonopticianshearingcare.co.uk, and send from Admin@...
RESEND_API_KEY=

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Calendly / Booking
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/wootton-hearing

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Stripe (optional e-commerce)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Contentful CMS (optional)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
